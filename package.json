{
  "name": "parent-teacher-summarizer",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-changelog.js && vite build",
    "build:desktop": "vite build --mode desktop",
    "electron:build:mac": "npm run build:desktop && electron-builder --config electron-builder.json --mac --arm64",
    "electron:build:win": "npm run build:desktop && electron-builder --config electron-builder.json --win --x64",
    "electron:build": "npm run build:desktop && electron-builder --config electron-builder.json --mac --arm64 && electron-builder --config electron-builder.json --win --x64",
    "dist:lite:mac": "npm run build:desktop && electron-builder --config electron-builder.lite.cjs --mac --arm64",
    "dist:lite:win": "npm run build:desktop && electron-builder --config electron-builder.lite.cjs --win --x64",
    "dist:lite": "npm run build:desktop && electron-builder --config electron-builder.lite.cjs --mac --arm64 && electron-builder --config electron-builder.lite.cjs --win --x64",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84",
    "lucide-react": "^1.31.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "44.9.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
