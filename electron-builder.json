{
  "appId": "com.teacher.gcrec",
  "productName": "教師輔導紀錄小幫手",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist-desktop/**/*",
    "electron/**/*",
    "package.json"
  ],
  "mac": {
    "icon": "build/icon.icns",
    "target": [
      { "target": "dmg", "arch": ["arm64"] },
      { "target": "zip", "arch": ["arm64"] }
    ],
    "category": "public.app-category.education",
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "identity": null
  },
  "win": {
    "icon": "build/icon.png",
    "target": [
      { "target": "zip", "arch": ["x64"] }
    ]
  }
}
